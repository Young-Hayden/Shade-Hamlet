  - "\u540D\u518C\u88AB\u8840\u6D78\u900F\uFF0C\u53EA\u5269\u4E00\u4E2A\u540D\u5B57\u8FD8\u80FD\u8FA8\u8BA4\u3002"
  - "\u6751\u91CC\u5F00\u59CB\u6328\u5BB6\u641C\u6355\u3002\u4F60\u5E26\u7740\u90A3\u534A\u4E2A\u540D\u5B57\u79BB\u5F00\u3002"
  spareEndingSubtitles:
  - "\u4ED6\u7559\u4E0B\u540D\u518C\uFF0C\u671D\u6751\u53E3\u8D70\u53BB\uFF0C\u6CA1\u6709\u56DE\u5934\u3002"
  - "\u540D\u518C\u6307\u5411\u771F\u6B63\u4E0B\u4EE4\u7684\u4EBA\u3002\u4F60\u7684\u4EC7\uFF0C\u8FD8\u6CA1\u62A5\u5B8C\u3002"
