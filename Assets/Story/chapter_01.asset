  killEndingSubtitles:
  - "\u5200\u843D\u4E0B\u53BB\u7684\u65F6\u5019\uFF0C\u4F60\u6CA1\u6709\u95EE\u51FA\u90A3\u4E2A\u540D\u5B57\u3002"
  - "\u590D\u4EC7\u5B8C\u6210\u4E86\uFF0C\u771F\u76F8\u5374\u968F\u4ED6\u4E00\u8D77\u6B7B\u53BB\u3002"
