  lines:
  - speaker: "\u70E7\u7126\u7684\u5BB6\u4E66"
    text: "\u201C\u706B\u8D77\u6765\u7684\u65F6\u5019\uFF0C\u95E8\u4ECE\u5916\u9762\u6263\u4E0A\u4E86\u3002\u5E26\u961F\u7684\u4EBA\u8BF4\uFF0C\u8FD9\u662F\u547D\u4EE4\u3002\u201D"
  - speaker: "\u4E3B\u89D2"
    text: "\u8FD9\u662F\u7236\u4EB2\u7684\u5B57\u3002\u53EF\u8FD9\u9053\u547D\u4EE4\uFF0C\u7A76\u7ADF\u662F\u8C01\u7B7E\u7684\uFF1F"
