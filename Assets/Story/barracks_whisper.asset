  lines:
  - speaker: "\u5E74\u8F7B\u536B\u5175"
    text: "\u961F\u957F\u53C8\u4E00\u4E2A\u4EBA\u5728\u4E95\u8FB9\u3002\u4ED6\u603B\u8BF4\u90A3\u665A\u4E0D\u8BE5\u5C01\u95E8\u3002"
  - speaker: "\u536B\u5175\u540C\u4F34"
    text: "\u5C0F\u58F0\u70B9\u3002\u5C01\u95E8\u4EE4\u662F\u4E0A\u9762\u7B7E\u7684\uFF0C\u4ED6\u4E00\u4E2A\u961F\u957F\u80FD\u6297\u547D\u5417\uFF1F"
  - speaker: "\u4E3B\u89D2"
    text: "\u4E0D\u662F\u4ED6\u4E0B\u7684\u4EE4\u2026\u2026\u4F46\u4ED6\u77E5\u9053\u7B7E\u540D\u7684\u4EBA\u662F\u8C01\u3002"
